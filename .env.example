# Replace invalid values only on the server; chmod 600 .env
MUSIC_TAG_IMAGE=music-tag:REPLACE_WITH_COMMIT
APP_PORT=18081
DATABASE_ENABLED=true
MYSQL_HOST=REPLACE_WITH_DATABASE_HOST
MYSQL_PORT=3306
MYSQL_DATABASE=REPLACE_WITH_DATABASE_NAME
MYSQL_USER=REPLACE_WITH_DATABASE_USER
MYSQL_PASSWORD=INVALID_REPLACE_ME
DATA_ROOT=/REPLACE_WITH_DATA_DIRECTORY
MINIO_ENABLED=false
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_PREFIX=music
RETENTION=30d
MIN_FREE_BYTES=1073741824
MIN_FREE_PERCENT=5
# Optional Compose MinIO profile: endpoint uses service name minio and port 9000.
MINIO_DATA_ROOT=/REPLACE_WITH_DEDICATED_DIRECTORY
